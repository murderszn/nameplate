# Runtime connection. Use the Supabase session pooler for a persistent NestJS
# service, or local Postgres while developing.
DATABASE_URL="postgresql://user:password@localhost:5432/nameplate?schema=public"

# Direct database connection for Prisma migrations and administrative work.
# Local development may use the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/nameplate?schema=public"

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_JWT_AUDIENCE="authenticated"
# Optional override; defaults to ${SUPABASE_URL}/auth/v1.
# SUPABASE_JWT_ISSUER="https://your-project-ref.supabase.co/auth/v1"

# Keep authentication enabled outside explicit local/demo runs.
AUTH_REQUIRED="true"
MEDIA_BUCKET="media"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:8012"
# Long random secret used to sign offline NPID allocation blocks.
NPID_SIGNING_SECRET="replace-with-a-secret-manager-value"
PORT=3000
