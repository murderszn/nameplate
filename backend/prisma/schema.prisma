// Nameplate API — Prisma schema (V0 scaffold)
//
// Source of truth for entity shape: docs/data-model.md
// Source of truth for architecture decisions: docs/architecture.md §2
//
// This is a LEAN V0 scaffold covering the core entities called out for
// scaffolding: Organization, Property, Building, Unit, AssetCategory,
// Asset, ServiceEvent, Part, WorkOrder, and User (with roles via
// Membership). Ledger/support tables referenced by data-model.md
// (asset_location, part_usage, audit_log, turn, reconciliation_flag,
// media, etc.) are intentionally NOT modeled yet — see the "Deferred"
// note at the bottom. Naming follows data-model.md §0 (snake_case
// columns/tables via @map/@@map, UUIDv7 ids, org_id tenancy, occurred_at
// vs recorded_at, soft delete via deleted_at, change_seq sync cursor).
//
// NOTE on generated columns (serial_normalized, labor_cost, total_cost):
// per data-model.md §10, Prisma cannot declare `GENERATED ALWAYS AS ...
// STORED` columns natively. They are declared here as plain, nullable,
// app/db-maintained columns; the real STORED-generated-column DDL must be
// hand-added to the first migration (see backend/README.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleT {
  technician
  lead_tech
  property_manager
  hq_admin
  owner
  viewer
  service_account

  @@map("role_t")
}

enum UserStatusT {
  invited
  active
  suspended

  @@map("user_status_t")
}

enum MembershipStatusT {
  invited
  active
  revoked

  @@map("membership_status_t")
}

enum PropertyStatusT {
  active
  onboarding
  inactive

  @@map("property_status_t")
}

enum AssetStatusT {
  active
  needs_repair
  awaiting_parts
  in_repair
  in_storage
  unaccounted_for
  retired
  disposed
  salvage

  @@map("asset_status_t")
}

enum AssetConditionT {
  new
  good
  fair
  poor
  failed

  @@map("asset_condition_t")
}

enum SerialConfidenceT {
  scanned
  ocr
  typed
  illegible
  absent

  @@map("serial_confidence_t")
}

enum CurrentLocationTypeT {
  unit
  storage
  vendor
  in_transit
  disposed
  unknown

  @@map("current_location_type_t")
}

enum ServiceEventTypeT {
  inspection
  diagnostic
  repair
  part_replacement
  full_replacement
  installation
  removal
  cleaning
  preventive_maintenance
  warranty_service
  decommission

  @@map("service_event_type_t")
}

enum ResolutionCodeT {
  fixed
  part_replaced
  asset_replaced
  no_fault_found
  deferred
  needs_vendor
  unrepairable

  @@map("resolution_code_t")
}

enum CostBorneByT {
  owner
  tenant
  warranty
  vendor
  insurance

  @@map("cost_borne_by_t")
}

enum RepairVsReplaceT {
  repaired
  replaced
  deferred

  @@map("repair_vs_replace_t")
}

enum PartOriginT {
  new_purchase
  salvaged
  warranty_replacement
  vendor_supplied
  unknown

  @@map("part_origin_t")
}

enum PartStatusT {
  in_stock
  installed
  scrapped
  returned
  lost
  reserved

  @@map("part_status_t")
}

enum PartConditionT {
  new
  tested_good
  untested
  refurbished
  suspect

  @@map("part_condition_t")
}

enum ComponentTypeT {
  control_board
  compressor
  motor
  pump
  heating_element
  thermostat
  valve
  belt
  door_seal
  filter
  sensor
  capacitor
  igniter
  blower
  fan
  hose
  handle
  shelf
  other

  @@map("component_type_t")
}

enum WorkOrderSourceT {
  tenant_request
  turn_inspection
  preventive
  technician
  inspection
  system

  @@map("work_order_source_t")
}

enum WorkOrderPriorityT {
  emergency
  urgent
  standard
  low

  @@map("work_order_priority_t")
}

enum WorkOrderStatusT {
  open
  assigned
  in_progress
  awaiting_parts
  awaiting_approval
  completed
  cancelled

  @@map("work_order_status_t")
}

enum RequestedActionT {
  diagnose
  repair
  replace
  inspect
  install
  remove

  @@map("requested_action_t")
}

enum WorkOrderResolutionT {
  repaired
  replaced
  no_fault_found
  deferred
  cancelled

  @@map("work_order_resolution_t")
}

// ---------------------------------------------------------------------------
// 1. Organization & identity
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  plan      String    @default("trial")
  settings  Json      @default("{}")
  timezone  String    @default("America/Phoenix")
  currency  String    @default("USD") @db.Char(3)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships       Membership[]
  properties        Property[]
  assetCategories   AssetCategory[]
  assets            Asset[]
  serviceEvents     ServiceEvent[]
  parts             Part[]
  workOrders        WorkOrder[]

  @@map("organization")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid // mirrors Supabase auth.users.id
  email          String      @unique // data-model.md specifies citext; plain unique text for V0 portability
  fullName       String      @map("full_name")
  phone          String?
  avatarMediaId  String?     @map("avatar_media_id") @db.Uuid
  status         UserStatusT @default(invited)
  lastSeenAt     DateTime?   @map("last_seen_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  memberships Membership[]

  @@map("user_account")
}

/// A user's role within an org (`data-model.md` §1 `membership`). This is
/// the "User with roles" join for multi-tenant/multi-org membership.
model Membership {
  id               String            @id @default(uuid()) @db.Uuid
  orgId            String            @map("org_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  role             RoleT
  employmentType   String?           @map("employment_type")
  hourlyLaborRate  Decimal?          @map("hourly_labor_rate") @db.Decimal(10, 2)
  status           MembershipStatusT @default(invited)
  invitedBy        String?           @map("invited_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  organization         Organization           @relation(fields: [orgId], references: [id])
  user                 User                    @relation(fields: [userId], references: [id])
  propertyAssignments  PropertyAssignment[]
  serviceEventsAuthored ServiceEvent[]         @relation("service_event_technician")
  assignedWorkOrders   WorkOrder[]             @relation("work_order_assignee")

  @@unique([orgId, userId])
  @@index([orgId, role])
  @@map("membership")
}

/// The scope gate — a technician sees only assigned properties.
/// hq_admin/owner have zero rows here by convention (absence = "all").
model PropertyAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  propertyId   String    @map("property_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  membership Membership @relation(fields: [membershipId], references: [id])
  property   Property   @relation(fields: [propertyId], references: [id])

  @@unique([membershipId, propertyId])
  @@index([orgId, propertyId])
  @@map("property_assignment")
}

// ---------------------------------------------------------------------------
// 2. Location hierarchy
// ---------------------------------------------------------------------------

model Property {
  id                  String          @id @default(uuid()) @db.Uuid
  orgId               String          @map("org_id") @db.Uuid
  name                String
  code                String?
  addressLine1        String?         @map("address_line1")
  addressLine2        String?         @map("address_line2")
  city                String?
  state               String?
  postalCode          String?         @map("postal_code")
  country             String          @default("US") @db.Char(2)
  latitude            Decimal?        @db.Decimal(9, 6)
  longitude           Decimal?        @db.Decimal(9, 6)
  timezone            String?
  unitCountDeclared   Int?            @map("unit_count_declared")
  yearBuilt           Int?            @map("year_built")
  status              PropertyStatusT @default(onboarding)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  changeSeq           BigInt          @default(autoincrement()) @map("change_seq")

  organization        Organization         @relation(fields: [orgId], references: [id])
  buildings            Building[]
  units                Unit[]
  propertyAssignments  PropertyAssignment[]
  assets               Asset[]
  serviceEvents        ServiceEvent[]
  workOrders           WorkOrder[]

  @@index([orgId, status])
  @@map("property")
}

model Building {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  name       String
  code       String?
  floors     Int?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  changeSeq  BigInt    @default(autoincrement()) @map("change_seq")

  property Property @relation(fields: [propertyId], references: [id])
  units    Unit[]

  @@index([orgId, propertyId])
  @@map("building")
}

model Unit {
  id                    String    @id @default(uuid()) @db.Uuid
  orgId                 String    @map("org_id") @db.Uuid
  propertyId            String    @map("property_id") @db.Uuid // denormalized from building, kept consistent by trigger
  buildingId            String    @map("building_id") @db.Uuid
  label                 String
  floor                 Int?
  bedrooms              Decimal?  @db.Decimal(3, 1)
  bathrooms             Decimal?  @db.Decimal(3, 1)
  squareFeet            Int?      @map("square_feet")
  occupancyStatus       String    @default("vacant") @map("occupancy_status") // enum('occupied','vacant','turning','offline','model')
  currentTurnId         String?   @map("current_turn_id") @db.Uuid
  lastTurnCompletedAt   DateTime? @map("last_turn_completed_at")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  changeSeq             BigInt    @default(autoincrement()) @map("change_seq")

  property      Property       @relation(fields: [propertyId], references: [id])
  building      Building       @relation(fields: [buildingId], references: [id])
  assets        Asset[]
  serviceEvents ServiceEvent[]
  workOrders    WorkOrder[]

  @@unique([propertyId, buildingId, label])
  @@index([orgId, propertyId, occupancyStatus])
  @@map("unit")
}

// ---------------------------------------------------------------------------
// 3. Asset catalog & assets
// ---------------------------------------------------------------------------

model AssetCategory {
  id                        String  @id @default(uuid()) @db.Uuid
  orgId                     String? @map("org_id") @db.Uuid // null = system-provided
  key                       String // washer, dryer, range, refrigerator, ...
  displayName               String  @map("display_name")
  defaultUsefulLifeMonths   Int     @map("default_useful_life_months")
  defaultReplacementCost    Decimal? @map("default_replacement_cost") @db.Decimal(12, 2)
  isSerialized              Boolean @default(true) @map("is_serialized")
  iconKey                   String? @map("icon_key")
  sortOrder                 Int?    @map("sort_order")

  organization Organization? @relation(fields: [orgId], references: [id])
  assets       Asset[]

  @@map("asset_category")
}

/// The crowd-populated, cross-tenant asset-master catalog.
/// See docs/asset-tagging-strategy.md §6.4.
model AssetModel {
  id                     String   @id @default(uuid()) @db.Uuid
  manufacturer           String
  modelNumber            String   @map("model_number")
  categoryId             String   @map("category_id") @db.Uuid
  displayName            String?  @map("display_name")
  serialFormatRegex      String?  @map("serial_format_regex")
  serialDateRule         Json?    @map("serial_date_rule")
  msrp                   Decimal? @db.Decimal(12, 2)
  typicalReplacementCost Decimal? @map("typical_replacement_cost") @db.Decimal(12, 2)
  expectedLifeMonths     Int?     @map("expected_life_months")
  spec                   Json?
  verificationStatus     String   @default("unverified") @map("verification_status")
  firstSeenOrgId         String?  @map("first_seen_org_id") @db.Uuid
  observationCount       Int      @default(1) @map("observation_count")
  mergedIntoId           String?  @map("merged_into_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  assets Asset[]

  @@unique([manufacturer, modelNumber])
  @@map("asset_model")
}

/// The core entity. See docs/data-model.md §3 and
/// docs/asset-tagging-strategy.md for why NPID (not the serial) is the key.
model Asset {
  id           String  @id @default(uuid()) @db.Uuid // UUIDv7, client-generatable offline
  orgId        String  @map("org_id") @db.Uuid
  npid         String  @unique // "NP-XXXXXXXX", Crockford Base32 + checksum
  categoryId   String  @map("category_id") @db.Uuid
  assetModelId String? @map("asset_model_id") @db.Uuid

  manufacturerRaw   String? @map("manufacturer_raw")
  modelRaw          String? @map("model_raw")
  serialNumber      String? @map("serial_number")
  // GENERATED ALWAYS AS (upper(regexp_replace(serial_number, '[^a-zA-Z0-9]', '', 'g'))) STORED
  // — added by hand in the first migration; kept here as a plain column for Prisma's type-safety.
  serialNormalized  String? @map("serial_normalized")
  serialConfidence  SerialConfidenceT @default(absent) @map("serial_confidence")
  altIdentifiers    Json    @default("[]") @map("alt_identifiers")

  // Location (current state — mirror of latest AssetLocation ledger row)
  currentLocationType        CurrentLocationTypeT @default(unknown) @map("current_location_type")
  currentUnitId               String?   @map("current_unit_id") @db.Uuid
  currentStorageLocationId    String?   @map("current_storage_location_id") @db.Uuid
  currentPropertyId           String?   @map("current_property_id") @db.Uuid
  currentLocationSince         DateTime? @map("current_location_since")
  currentLocationConfirmedAt   DateTime? @map("current_location_confirmed_at")
  currentLocationConfirmedBy   String?   @map("current_location_confirmed_by") @db.Uuid

  // Lifecycle
  status                  AssetStatusT      @default(active)
  condition                AssetConditionT?
  acquisitionType           String?          @map("acquisition_type")
  manufactureDate           DateTime?        @map("manufacture_date") @db.Date
  manufactureDateSource     String?          @map("manufacture_date_source")
  installDate               DateTime?        @map("install_date") @db.Date
  installDateConfidence     String?          @map("install_date_confidence")
  warrantyExpiresOn         DateTime?        @map("warranty_expires_on") @db.Date
  purchaseCost              Decimal?         @map("purchase_cost") @db.Decimal(12, 2)
  expectedLifeMonths        Int?             @map("expected_life_months")
  retiredAt                 DateTime?        @map("retired_at")
  retiredReason              String?          @map("retired_reason")
  replacedByAssetId          String?          @map("replaced_by_asset_id") @db.Uuid
  replacesAssetId             String?          @map("replaces_asset_id") @db.Uuid

  // Denormalized rollups — maintained by trigger/worker, never source of truth
  lifetimeServiceCost   Decimal   @default(0) @map("lifetime_service_cost") @db.Decimal(12, 2)
  serviceEventCount     Int       @default(0) @map("service_event_count")
  lastServiceAt         DateTime? @map("last_service_at")
  nextServiceDueAt      DateTime? @map("next_service_due_at")

  notes        String?
  customFields Json    @default("{}") @map("custom_fields")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  changeSeq BigInt    @default(autoincrement()) @map("change_seq")

  organization  Organization    @relation(fields: [orgId], references: [id])
  category      AssetCategory   @relation(fields: [categoryId], references: [id])
  assetModel    AssetModel?     @relation(fields: [assetModelId], references: [id])
  currentUnit   Unit?           @relation(fields: [currentUnitId], references: [id])
  currentProperty Property?     @relation(fields: [currentPropertyId], references: [id])

  serviceEvents ServiceEvent[]
  workOrders    WorkOrder[]
  partsSourced  Part[]         @relation("part_source_asset")
  partsInstalled Part[]        @relation("part_installed_asset")

  @@index([orgId, currentPropertyId, status])
  @@index([orgId, currentUnitId])
  @@index([orgId, status])
  @@index([orgId, categoryId, installDate])
  @@index([assetModelId])
  @@index([orgId, currentLocationConfirmedAt])
  @@map("asset")
}

// ---------------------------------------------------------------------------
// 4. Service, work orders
// ---------------------------------------------------------------------------

model ServiceEvent {
  id    String @id @default(uuid()) @db.Uuid // UUIDv7, client-generated offline
  orgId String @map("org_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid

  workOrderId String? @map("work_order_id") @db.Uuid
  turnId      String? @map("turn_id") @db.Uuid

  // snapshotted at time of service — never re-derive from the asset
  unitId     String? @map("unit_id") @db.Uuid
  propertyId String? @map("property_id") @db.Uuid

  technicianId String @map("technician_id") @db.Uuid
  vendorId     String? @map("vendor_id") @db.Uuid

  eventType     ServiceEventTypeT @map("event_type")
  findings      String?
  symptomCodes  String[]          @default([]) @map("symptom_codes")
  resolutionCode ResolutionCodeT?  @map("resolution_code")

  conditionBefore AssetConditionT? @map("condition_before")
  conditionAfter  AssetConditionT? @map("condition_after")
  statusBefore    AssetStatusT?    @map("status_before")
  statusAfter     AssetStatusT?    @map("status_after")

  laborMinutes Int?     @map("labor_minutes")
  laborRate    Decimal? @map("labor_rate") @db.Decimal(10, 2)
  // GENERATED ALWAYS AS (labor_minutes / 60.0 * labor_rate) STORED — hand-added in migration
  laborCost    Decimal? @map("labor_cost") @db.Decimal(12, 2)
  partsCost    Decimal  @default(0) @map("parts_cost") @db.Decimal(12, 2)
  otherCost    Decimal  @default(0) @map("other_cost") @db.Decimal(12, 2)
  // GENERATED ALWAYS AS (labor_cost + parts_cost + other_cost) STORED — hand-added in migration
  totalCost    Decimal? @map("total_cost") @db.Decimal(12, 2)

  costBorneBy CostBorneByT? @map("cost_borne_by")
  isWarrantyClaim Boolean   @default(false) @map("is_warranty_claim")

  repairVsReplaceDecision RepairVsReplaceT? @map("repair_vs_replace_decision")
  replacementAssetId      String?           @map("replacement_asset_id") @db.Uuid
  estimatedRepairCostIfDeferred Decimal?     @map("estimated_repair_cost_if_deferred") @db.Decimal(12, 2)

  tenantPresent       Boolean? @map("tenant_present")
  followUpRequired    Boolean  @default(false) @map("follow_up_required")
  signatureMediaId    String?  @map("signature_media_id") @db.Uuid

  occurredAt DateTime @map("occurred_at")
  recordedAt DateTime @default(now()) @map("recorded_at")
  deviceId   String?  @map("device_id")
  createdBy  String?  @map("created_by") @db.Uuid
  changeSeq  BigInt   @default(autoincrement()) @map("change_seq")

  correctedByEventId String? @map("corrected_by_event_id") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])
  technician   Membership   @relation("service_event_technician", fields: [technicianId], references: [id])
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id])

  partUsages PartUsage[]

  @@index([assetId, occurredAt(sort: Desc)])
  @@index([orgId, occurredAt(sort: Desc)])
  @@index([orgId, propertyId, occurredAt(sort: Desc)])
  @@index([technicianId, occurredAt(sort: Desc)])
  @@index([orgId, eventType, occurredAt(sort: Desc)])
  @@map("service_event")
}

model WorkOrder {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  number     Int    // human-facing per-org sequence: WO-1042

  unitId  String? @map("unit_id") @db.Uuid
  assetId String? @map("asset_id") @db.Uuid
  turnId  String? @map("turn_id") @db.Uuid

  title       String
  description String?

  source           WorkOrderSourceT
  priority         WorkOrderPriorityT
  status           WorkOrderStatusT     @default(open)
  assignedTo       String?              @map("assigned_to") @db.Uuid
  requestedAction  RequestedActionT?    @map("requested_action")
  resolution       WorkOrderResolutionT?

  slaDueAt        DateTime? @map("sla_due_at")
  firstResponseAt DateTime? @map("first_response_at")
  completedAt     DateTime? @map("completed_at")
  slaMet          Boolean?  @map("sla_met")

  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(12, 2)
  actualCost    Decimal? @map("actual_cost") @db.Decimal(12, 2)

  approvalRequired Boolean   @default(false) @map("approval_required")
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at")

  tenantPresentRequired Boolean   @default(false) @map("tenant_present_required")
  scheduledFor          DateTime? @map("scheduled_for")

  occurredAt DateTime? @map("occurred_at")
  recordedAt DateTime  @default(now()) @map("recorded_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by") @db.Uuid
  changeSeq  BigInt    @default(autoincrement()) @map("change_seq")

  organization Organization @relation(fields: [orgId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])
  asset        Asset?       @relation(fields: [assetId], references: [id])
  assignee     Membership?  @relation("work_order_assignee", fields: [assignedTo], references: [id])

  serviceEvents ServiceEvent[]

  @@unique([orgId, number])
  @@index([orgId, status, slaDueAt])
  @@index([orgId, assignedTo, status])
  @@index([assetId, createdAt(sort: Desc)])
  @@map("work_order")
}

// ---------------------------------------------------------------------------
// 5. Parts & lineage
// ---------------------------------------------------------------------------

model PartCatalog {
  id                    String   @id @default(uuid()) @db.Uuid
  manufacturer          String
  partNumber            String   @map("part_number")
  name                  String
  componentType         ComponentTypeT @map("component_type")
  compatibleModelIds    String[] @default([]) @map("compatible_model_ids") @db.Uuid
  typicalCost           Decimal? @map("typical_cost") @db.Decimal(12, 2)
  expectedLifeMonths    Int?     @map("expected_life_months")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  parts      Part[]
  partUsages PartUsage[]

  @@unique([manufacturer, partNumber])
  @@map("part_catalog")
}

/// A specific physical part instance worth tracing — the product's
/// signature "lineage" feature. See docs/data-model.md §5.
model Part {
  id            String  @id @default(uuid()) @db.Uuid
  orgId         String  @map("org_id") @db.Uuid
  partCatalogId String? @map("part_catalog_id") @db.Uuid

  label         String?
  componentType ComponentTypeT @map("component_type")
  serialNumber  String?        @map("serial_number")

  origin PartOriginT @default(unknown)

  sourceAssetId              String?   @map("source_asset_id") @db.Uuid // the lineage link
  sourceServiceEventId        String?   @map("source_service_event_id") @db.Uuid
  salvagedAt                  DateTime? @map("salvaged_at")
  salvagedBy                  String?   @map("salvaged_by") @db.Uuid
  sourceAssetAgeMonthsAtSalvage Int?    @map("source_asset_age_months_at_salvage")

  condition PartConditionT @default(untested)
  status    PartStatusT    @default(in_stock)

  currentStorageLocationId String? @map("current_storage_location_id") @db.Uuid
  installedInAssetId       String? @map("installed_in_asset_id") @db.Uuid

  acquisitionCost Decimal  @default(0) @map("acquisition_cost") @db.Decimal(12, 2)
  imputedValue    Decimal? @map("imputed_value") @db.Decimal(12, 2)
  warrantyExpiresOn DateTime? @map("warranty_expires_on") @db.Date

  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  changeSeq BigInt    @default(autoincrement()) @map("change_seq")

  organization    Organization  @relation(fields: [orgId], references: [id])
  partCatalog     PartCatalog?  @relation(fields: [partCatalogId], references: [id])
  sourceAsset     Asset?        @relation("part_source_asset", fields: [sourceAssetId], references: [id])
  installedInAsset Asset?       @relation("part_installed_asset", fields: [installedInAssetId], references: [id])

  usages           PartUsage[] @relation("part_usage_part")
  removedInUsages  PartUsage[] @relation("part_usage_removed_part")

  @@index([orgId, status, componentType])
  @@index([sourceAssetId])
  @@index([installedInAssetId])
  @@map("part")
}

/// Append-only installation/removal record.
model PartUsage {
  id             String  @id @default(uuid()) @db.Uuid
  orgId          String  @map("org_id") @db.Uuid
  serviceEventId String  @map("service_event_id") @db.Uuid
  assetId        String  @map("asset_id") @db.Uuid

  partId        String? @map("part_id") @db.Uuid
  partCatalogId String? @map("part_catalog_id") @db.Uuid
  description   String?

  action   String // enum('installed','removed','swapped','tested','returned')
  quantity Decimal @default(1) @db.Decimal(8, 2)
  unitCost Decimal @default(0) @map("unit_cost") @db.Decimal(12, 2)
  // GENERATED ALWAYS AS (quantity * unit_cost) STORED — hand-added in migration
  totalCost Decimal? @map("total_cost") @db.Decimal(12, 2)
  costSource String  @default("actual") @map("cost_source")

  removedPartId          String? @map("removed_part_id") @db.Uuid
  removedPartDisposition String? @map("removed_part_disposition")
  warrantyCovered        Boolean @default(false) @map("warranty_covered")

  occurredAt DateTime @map("occurred_at")
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdBy  String?  @map("created_by") @db.Uuid
  changeSeq  BigInt   @default(autoincrement()) @map("change_seq")

  serviceEvent ServiceEvent @relation(fields: [serviceEventId], references: [id])
  part         Part?        @relation("part_usage_part", fields: [partId], references: [id])
  partCatalog  PartCatalog? @relation(fields: [partCatalogId], references: [id])
  removedPart  Part?        @relation("part_usage_removed_part", fields: [removedPartId], references: [id])

  @@index([assetId, occurredAt(sort: Desc)])
  @@index([partId])
  @@index([serviceEventId])
  @@index([orgId, partCatalogId, occurredAt(sort: Desc)])
  @@map("part_usage")
}

