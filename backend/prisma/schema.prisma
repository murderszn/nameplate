  @@map("vendor")
}

model Turn {
  id                String      @id @default(uuid()) @db.Uuid
  orgId             String      @map("org_id") @db.Uuid
  propertyId        String      @map("property_id") @db.Uuid
  unitId            String      @map("unit_id") @db.Uuid
  type              TurnTypeT
  status            TurnStatusT @default(scheduled)
  scheduledFor      DateTime?   @map("scheduled_for") @db.Timestamptz(3)
  startedAt         DateTime?   @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?   @map("completed_at") @db.Timestamptz(3)
  performedBy       String      @map("performed_by") @db.Uuid
  previousTenantRef String?     @map("previous_tenant_ref")
  itemsTotal        Int         @default(0) @map("items_total")
  itemsPresent      Int         @default(0) @map("items_present")
  itemsMissing      Int         @default(0) @map("items_missing")
  itemsDamaged      Int         @default(0) @map("items_damaged")
  assetsAdded       Int         @default(0) @map("assets_added")
  assetsRemoved     Int         @default(0) @map("assets_removed")
  estimatedCost     Decimal?    @map("estimated_cost") @db.Decimal(12, 2)
  actualCost        Decimal?    @map("actual_cost") @db.Decimal(12, 2)
  notes             String?
  occurredAt        DateTime?   @map("occurred_at") @db.Timestamptz(3)
  recordedAt        DateTime    @default(now()) @map("recorded_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(3)
  changeSeq         BigInt      @default(autoincrement()) @map("change_seq")

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, propertyId, status])
  @@index([unitId, completedAt(sort: Desc)])
  @@map("turn")
